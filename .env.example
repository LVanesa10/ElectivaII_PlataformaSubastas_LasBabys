# Puerto en el que escucha el servidor HTTP y de WebSockets
PUERTO=3000

# Secreto usado para firmar y verificar los tokens de sesion (JWT).
# Genere un valor propio y unico para cada entorno; nunca use este valor en produccion.
JWT_SECRETO=

# Motor de persistencia: "sqlite" (por defecto, los datos sobreviven a reinicios)
# o "memoria" (los datos se pierden al detener el proceso).
PERSISTENCIA=sqlite

# Ruta del archivo de base de datos SQLite. La carpeta se crea si no existe.
RUTA_BASE_DATOS=./datos/subastas.db

# Secreto compartido con la pasarela de pagos para firmar las notificaciones
# del webhook (HMAC-SHA256). Si se deja vacio, toda notificacion se rechaza.
PASARELA_SECRETO=
